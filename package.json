{
  "name": "file-upload-vercel",
  "version": "1.0.0",
  "description": "Distributed File Upload System for Vercel",
  "main": "index.js",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "cd frontend && npm run dev",
    "vercel-build": "cd frontend && npm run build",
    "start": "cd frontend && npm run preview",
    "postinstall": "cd frontend && npm ci"
  },
  "dependencies": {
    "@vercel/node": "^5.3.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "multiparty": "^4.2.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/multiparty": "^0.0.36",
    "@types/node": "^20.11.30",
    "@types/sqlite3": "^5.1.0",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.x"
  }
}
